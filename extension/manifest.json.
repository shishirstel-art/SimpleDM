{
  "manifest_version": 3,
  "name": "SimpleDM Catcher",
  "version": "1.0",
  "description": "Send downloads and magnet links to SimpleDM",
  "permissions": ["downloads", "contextMenus", "cookies"],
  "host_permissions": ["http://127.0.0.1:9614/*", "<all_urls>"],
  "background": { "service_worker": "background.js" }
}
